rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is an active admin
    function isAdmin(auth) {
      return auth != null && 
        exists(/databases/$(database)/documents/admins/$(auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(auth.uid)).data.status == 'active';
    }

    // Lock down everything by default, allowing access only to active admins
    match /{document=**} {
      allow read, write: if isAdmin(request.auth);
    }
    
    // Explicitly allow anyone to READ the API key collection
    match /apikey/{document=**} {
      allow read: if true;
      allow write: if isAdmin(request.auth);
    }
    
    // Allow users to read their own Admin Profile for login validation
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if isAdmin(request.auth);
    }
  }
}
